# Copy this file to .env and fill in real values. Never commit .env.
#
# Leave these EMPTY while dry_run is true in user_data/config.json --
# dry-run does not need real API keys at all.
#
# When you move to Binance Futures TESTNET (paper trading against live
# prices with a simulated exchange account), get keys from
# https://testnet.binancefuture.com and set:
#   FREQTRADE__EXCHANGE__KEY=your_testnet_key
#   FREQTRADE__EXCHANGE__SECRET=your_testnet_secret
#   FREQTRADE__EXCHANGE__CCXT_CONFIG={"urls":{"api":{"fapiPublic":"https://testnet.binancefuture.com/fapi/v1","fapiPrivate":"https://testnet.binancefuture.com/fapi/v1"}}}
#
# When you move to LIVE trading, use a Binance API key restricted to
# "Enable Futures" / "Enable Spot & Margin Trading" ONLY -- never enable
# withdrawals -- and ideally IP-whitelisted to your server's IP.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Optional: Telegram bot for trade notifications and remote control.
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
